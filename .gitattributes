* text=auto eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.ps1 text eol=crlf
*.obj text eol=lf

# Preserve generated artifacts byte-for-byte, including ASCII-encoded PDFs.
*.pdf binary
*.pptx binary
*.mp4 binary
*.png binary
*.jpg binary
*.stl binary
*.npz binary
*.npy binary
*.safetensors binary
*.bin binary

# These evaluated packages contain byte-level manifests. Preserve original
# newlines as well as binary weights so a fresh checkout matches their hashes.
models/bottle_relays/** -text whitespace=cr-at-eol
models/dinner_suite/** -text whitespace=cr-at-eol
models/spoon_release_v1/** -text whitespace=cr-at-eol
models/mug_release_v1/** -text whitespace=cr-at-eol
training/bottle_relays/** -text whitespace=cr-at-eol
training/dinner_suite/** -text whitespace=cr-at-eol
training/spoon_release_v1/** -text whitespace=cr-at-eol
training/mug_release_v1/** -text whitespace=cr-at-eol
models/bottle_servo_v1/** -text whitespace=cr-at-eol
training/bottle_servo_v1/** -text whitespace=cr-at-eol
docs/robotics/evidence/** -text whitespace=cr-at-eol
docs/robotics/experiments/** -text whitespace=cr-at-eol

# Generated state scenes preserve their original XML indentation and hashes.
docs/robotics/evidence/rgb-servo-v1/**/scene.xml -whitespace
docs/robotics/evidence/rgb-servo-v2/**/scene.xml -whitespace
docs/robotics/evidence/rgb-servo-v5/**/scene.xml -whitespace
docs/robotics/evidence/rgb-servo-observer-camera-v1/validation/scene.xml -whitespace
docs/robotics/evidence/composed-dinner-v1/**/scene.xml -whitespace
docs/robotics/evidence/spoon-release-v1/**/scene.xml -whitespace
docs/robotics/evidence/mug-release-v1/**/scene.xml -whitespace
training/bottle_servo_v1/motion/**/scene.xml -whitespace
training/spoon_release_v1/**/scene.xml -whitespace
training/mug_release_v1/**/scene.xml -whitespace
